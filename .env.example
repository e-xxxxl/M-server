# NMREP API configuration.
#
# Copy this file to backend/.env and fill it in. backend/.env is git-ignored.
# NEVER commit real values, and never paste them into chats, documents or code.
# On a host such as Render, set these as environment variables in its dashboard instead of using a file.
# On the VPS, the file lives at /opt/nmrep/backend/.env and is readable only by the nmrep user (chmod 600).
# Every value below is an EXAMPLE or a placeholder. Replace it in your real .env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your MongoDB connection string, including the database name.
#   MongoDB on the VPS (see DEPLOY-VPS.md; the password is the one you generated for the nmrep_app user):
#     mongodb://nmrep_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:27017/nmrep?authSource=nmrep
#   MongoDB Atlas:
#     mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/nmrep?retryWrites=true&w=majority
# A password with special characters (@ : / ? # %) must be URL-encoded.
MONGODB_URI=mongodb://nmrep_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:27017/nmrep?authSource=nmrep

# development or production. In production, cookies are sent over HTTPS only and the app prints less.
NODE_ENV=production

# Websites allowed to call the API, comma separated, no trailing slash.
#   Production: CORS_ORIGINS=https://nmrep.ng
#   Local development: CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=https://nmrep.ng

# ---------------------------------------------------------------------------
# Where the API listens
# ---------------------------------------------------------------------------

# Port. Render sets PORT for you. On the VPS nginx forwards to this port.
PORT=4000

# Address to listen on. On the VPS keep 127.0.0.1 so the API can only be reached through nginx.
# Leave unset (all addresses) on Render.
HOST=127.0.0.1

# Number of reverse proxies in front of the API. 1 for nginx on the VPS and for Render.
# It makes the API see each visitor's real IP address (needed for rate limits).
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Email through Resend (https://resend.com)
# ---------------------------------------------------------------------------
# Used for password reset links, email address confirmation and short updates about verification and
# application decisions. Without RESEND_API_KEY and EMAIL_FROM, email is switched off: everything else
# works, but reset and confirmation links are not sent.

# Your Resend API key (starts with re_). Create it in Resend with "Sending access" only.
# This is a placeholder. Put the real key only in the real .env on the server.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The sender. The domain must be verified in Resend (add its DNS records, see DEPLOY-VPS.md).
EMAIL_FROM=NMREP <no-reply@nmrep.ng>

# Optional. Where replies go. Leave blank for none.
# EMAIL_REPLY_TO=support@nmrep.ng

# The website's address, used for the links inside emails. No trailing slash.
APP_URL=https://nmrep.ng

# Also email owners about verification and application decisions (default true).
# Set to false to send only password reset and confirmation emails.
# EMAIL_NOTIFICATIONS=true

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Login session length in days (default 7).
# SESSION_TTL_DAYS=7

# Cookie settings. Leave these alone when the site is nmrep.ng and the API is api.nmrep.ng.
# They are on the same registrable domain, so the default "lax" is correct and safest.
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# The mobile app needs no setting here. It sends "X-Client: app" and the API then returns a Bearer token and keeps
# the session alive while the app is used: 30 days from the last use, never more than 90 days after the login.
# APP_SESSION_TTL_DAYS=30
# APP_SESSION_MAX_DAYS=90

# LEGACY, TESTING ONLY. Set to true while the site and the API are on unrelated domains (for example the site on
# nmrep.ng and the API on onrender.com), where browsers block the login cookie. The API then also returns
# the session token to browsers and accepts it as "Authorization: Bearer <token>" without "X-Client: app". The token
# is kept in browser storage, which any script on the page can read, so this is weaker than the cookie. Leave it off
# on the VPS (api.nmrep.ng with cookies). The mobile app does not need it any more.
# ALLOW_TOKEN_AUTH=false

# Per IP address, per 15 minutes. The defaults are sensible.
# RATE_LIMIT_LOGIN=15
# RATE_LIMIT_REGISTER=10
# RATE_LIMIT_RESET=10
# RATE_LIMIT_GENERAL=600

# ---------------------------------------------------------------------------
# Automated verification checks (NIN and CAC) through Prembly
# ---------------------------------------------------------------------------
# Off unless BOTH of these are set. Manual review by an administrator works either way.
# Never put the real values in git, in the website, or in a message. They live only in the real .env on the server.
#
# The secret API key from your Prembly dashboard. It is sent only to Prembly, in a request header.
# Prembly's test mode (a switch in its dashboard) uses the same address with a test key that starts with test_:
# it answers with made up data and never bills. Use it for development. Production must use the live key (a test
# mode answer is refused there). Try it with: npm run prembly-check
# PREMBLY_API_KEY=put-your-prembly-secret-key-here
#
# A long random secret (at least 32 characters) used to fingerprint NIN numbers, so the same number used
# on two accounts can be noticed without the number ever being stored. Create one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Do not change it after launch: old fingerprints would stop matching.
# VERIFICATION_HASH_KEY=put-a-long-random-secret-here
#
# Trying a Prembly TEST key on the live server? A test key answers with made up data, and the live server refuses that by
# default (owners would see "Verification is not available right now" and the log says the provider answered in sandbox
# mode). To try it anyway, set the next line, restart, test, then REMOVE it and switch to the live key before real owners
# use the site. With made up data the names will not match, so results show "Needs review".
# PREMBLY_ALLOW_SANDBOX=true
#
# Optional. The default is Prembly's live address.
# PREMBLY_BASE_URL=https://api.prembly.com
#
# Every call can cost money (the NIN check was listed at 50 NGN). Limits per business per rolling 24 hours:
# VERIFICATION_MAX_PER_TYPE_PER_DAY=3
# VERIFICATION_MAX_PER_DAY=8

# ---------------------------------------------------------------------------
# Document wallet (private, encrypted files)
# ---------------------------------------------------------------------------
# Off unless a key is set. Files are encrypted with AES-256-GCM before they touch the disk, so a copy of the folder or of
# a backup cannot be read without this key. Never put the real value in git, in the website, or in a message.
#
# Create the key once with:  npm run document-key   (it only prints; it writes nothing)
# Keep a copy in your password manager. IF YOU LOSE IT, EVERY STORED DOCUMENT BECOMES UNREADABLE. Never change it while
# documents exist.
# DOCUMENT_ENCRYPTION_KEY=put-a-32-byte-base64-key-here
#
# Where the encrypted files go. On the VPS use /var/lib/nmrep/documents (the service creates /var/lib/nmrep). Never inside
# the website or the release folder. Include this folder in backups.
# DOCUMENT_STORAGE_DIR=/var/lib/nmrep/documents
#
# Limits per file, per business and in total per business.
# DOCUMENT_MAX_MB=5
# DOCUMENT_MAX_FILES=20
# DOCUMENT_MAX_TOTAL_MB=40

# ---------------------------------------------------------------------------
# Registration fee: ALATPay (bank transfer) and Paystack (card and bank)
# ---------------------------------------------------------------------------
# The yearly fee is taken through ONE gateway at a time. Both can be set up here; the super admin chooses which is in use in
# the admin portal (Settings). With no choice, ALATPay is used when it is set up, otherwise Paystack. The fee is OFF until
# the gateway in use has its keys.
#
# ALATPay (https://alatpay.ng): the payer transfers the fee to a one-time account number. Both values are in the ALATPay
# dashboard: Settings, Business, View (it asks for your ALATPay PIN). Never put the real values in git or a message.
# In the same place set the webhook URL to:  https://api.nmrep.ng/api/webhooks/alatpay
# ALATPAY_SECRET_KEY=your_alatpay_secret_key
# ALATPAY_BUSINESS_ID=your-alatpay-business-id-uuid
# ALATPAY_BASE_URL=https://apibox.alatpay.ng
#
# Which gateway to use when the super admin has not chosen one: alatpay or paystack.
# PAYMENT_GATEWAY=alatpay

# ---------------------------------------------------------------------------
# Paystack (card and bank on Paystack's page)
# ---------------------------------------------------------------------------
# Every business owner pays a yearly registration fee. It is OFF until a Paystack secret key is set: without one nobody
# is asked to pay. Use a TEST key (sk_test_...) first: it takes Paystack's test cards and moves no money. Switch to the
# live key (sk_live_...) only for launch. Never put the real value in git, in the website, or in a message.
# In the Paystack dashboard (Settings, API Keys & Webhooks) also set the webhook URL to:
#   https://api.nmrep.ng/api/webhooks/paystack
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# The fee in naira and how long one payment lasts.
# REGISTRATION_FEE_NAIRA=1000
# REGISTRATION_PERIOD_DAYS=365
# These are the starting values. The super admin can override them in the admin portal (Settings) without a restart.
#
# Only for tests against a stand-in server. Leave it out in real use.
# PAYSTACK_BASE_URL=https://api.paystack.co

# ---------------------------------------------------------------------------
# Notifications: push to the phone app, and the "Stop these emails" links
# ---------------------------------------------------------------------------
# Push notifications. THE NMREP APP ONLY SENDS EXPO PUSH TOKENS (ExponentPushToken[...]), which are delivered through Expo and
# need nothing here. Leave EXPO_ACCESS_TOKEN empty unless "enhanced push security" is turned on in the Expo account (it is off
# unless someone enabled it). Do NOT set the FIREBASE_ lines below for this app: the Firebase private key belongs in Expo
# (Android credentials, the FCM V1 service account key), not on this server. They exist only for raw Firebase device tokens,
# which this app does not send. A raw Firebase token needs a Firebase SERVICE ACCOUNT key: in the Firebase console, Project settings, Service accounts,
# Generate new private key. That JSON file is a secret (treat it like a password): keep it on the server outside the website
# folder, permissions 600, and never commit it or send it in a message. Without it only Expo tokens are delivered.
# EXPO_ACCESS_TOKEN=
# FIREBASE_SERVICE_ACCOUNT_FILE=/opt/nmrep/shared/firebase-service-account.json
# Alternative to the file, for hosts that only offer environment variables: the same JSON encoded as base64.
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Normally read from the key file. Set only to override.
# FIREBASE_PROJECT_ID=
# Set to false to switch push off on purpose.
# PUSH_ENABLED=true
#
# Signs the "Stop these emails" links in notification emails. Set a long random value on a real server, otherwise the links
# stop working whenever the server restarts. Create one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# UNSUBSCRIBE_SECRET=put-a-long-random-value-here

# The reminder job (programmes closing soon, training sessions tomorrow). On by default.
# REMINDERS_ENABLED=true
# REMINDERS_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Staff alerts and the website contact form
# ---------------------------------------------------------------------------
# These go to the NMREP staff inbox by email (when email is on): a new registration, a registration fee paid, a check that
# needs a reviewer, and every website contact form message. A comma separated list. The default is admin@nmrep.org.
# Set it to nothing (STAFF_ALERT_EMAIL=) to switch the alerts off. Messages from the contact form are always kept in the
# admin portal (Enquiries) as well.
# STAFF_ALERT_EMAIL=admin@nmrep.org
# Only if the contact form should go to a different inbox from the alerts:
# CONTACT_EMAIL=
