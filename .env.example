# NMREP API configuration. Copy this file to backend/.env and fill it in.
# backend/.env is git-ignored. NEVER commit it, and never paste real values into chats, docs or code.
# On a host such as Render, set these as environment variables in the dashboard instead of using a file.

# Required. Your MongoDB connection string (for example from MongoDB Atlas).
# Include the database name, for example .../nmrep?retryWrites=true&w=majority
MONGODB_URI=

# Port the API listens on. Render sets PORT for you.
PORT=4000

# development or production. In production, cookies are sent over HTTPS only.
NODE_ENV=development

# Websites allowed to call the API, comma separated, no trailing slash.
# Local development: the Next.js dev server. Production: your real site.
#   CORS_ORIGINS=https://nmrep.ng
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API. Render uses 1 (the default in production).
# TRUST_PROXY=1

# Login session length in days (default 7).
# SESSION_TTL_DAYS=7

# Cookie settings. Leave these alone when the site is nmrep.ng and the API is api.nmrep.ng.
# They are on the same registrable domain, so the default "lax" is correct and safest.
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
