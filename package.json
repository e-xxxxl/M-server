{
  "name": "nmrep-api",
  "version": "0.1.0",
  "private": true,
  "description": "NMREP API: accounts, sessions, business profiles and the dashboard data.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "main": "src/server.js",
  "scripts": {
    "document-key": "node scripts/create-document-key.js",
    "prembly-check": "node scripts/prembly-check.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/dev-memory.js",
    "create-super-admin": "node scripts/create-super-admin.js",
    "send-test-email": "node scripts/send-test-email.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.0",
    "zod": "^4.6.5"
